<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none">
  <defs>
    <linearGradient id="nexusGrad1" x1="10" y1="10" x2="110" y2="110" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#06B6D4"/>
      <stop offset="45%" stop-color="#6366F1"/>
      <stop offset="100%" stop-color="#8B5CF6"/>
    </linearGradient>
    <linearGradient id="nexusGrad2" x1="110" y1="10" x2="10" y2="110" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#A855F7"/>
      <stop offset="60%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>
    <linearGradient id="nodeGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#C084FC"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  
  <!-- Outer Rounded Diamond Shield -->
  <rect x="12" y="12" width="96" height="96" rx="28" fill="#0B0F19" stroke="url(#nexusGrad1)" stroke-width="3" />
  
  <!-- Glowing Background Accent -->
  <circle cx="60" cy="60" r="32" fill="url(#nexusGrad1)" opacity="0.18" filter="url(#glow)"/>
  
  <!-- Nexus Interlocking "N" Path -->
  <!-- Left Pillar -->
  <path d="M38 34 V86" stroke="url(#nexusGrad1)" stroke-width="8" stroke-linecap="round" />
  
  <!-- Right Pillar -->
  <path d="M82 34 V86" stroke="url(#nexusGrad1)" stroke-width="8" stroke-linecap="round" />
  
  <!-- Dynamic Diagonal Connector -->
  <path d="M38 38 L82 82" stroke="url(#nexusGrad2)" stroke-width="8" stroke-linecap="round" />
  
  <!-- Core Network Nodes -->
  <circle cx="38" cy="34" r="6" fill="#06B6D4" stroke="#FFFFFF" stroke-width="2.5" />
  <circle cx="38" cy="86" r="6" fill="#6366F1" stroke="#FFFFFF" stroke-width="2.5" />
  <circle cx="82" cy="34" r="6" fill="#8B5CF6" stroke="#FFFFFF" stroke-width="2.5" />
  <circle cx="82" cy="86" r="6" fill="#A855F7" stroke="#FFFFFF" stroke-width="2.5" />
  
  <!-- Central Spark Node -->
  <circle cx="60" cy="60" r="4.5" fill="#FFFFFF" filter="url(#glow)" />
</svg>